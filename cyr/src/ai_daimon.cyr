# ================================================================
# Content classification -- analyze_media
# ================================================================

enum ContentType {
    CT_MUSIC = 0;
    CT_SPEECH = 1;
    CT_PODCAST = 2;
    CT_MOVIE = 3;
    CT_CLIP = 4;
    CT_SCREENCAST = 5;
    CT_ANIMATION = 6;
    CT_UNKNOWN = 7;
}

fn ContentType_name(ct) {
    if (ct == CT_MUSIC) { return "music"; }
    if (ct == CT_SPEECH) { return "speech"; }
    if (ct == CT_PODCAST) { return "podcast"; }
    if (ct == CT_MOVIE) { return "movie"; }
    if (ct == CT_CLIP) { return "clip"; }
    if (ct == CT_SCREENCAST) { return "screencast"; }
    if (ct == CT_ANIMATION) { return "animation"; }
    return "unknown";
}

# MediaAnalysis struct
#   Layout: 32 bytes
#     +0: content_type (ContentType)
#     +8: quality_score (f64 bits, 0-100)
#     +16: complexity (f64 bits, 0-100)
#     +24: tags (vec of Str)

fn media_analysis_new(ct, quality, complexity) {
    var a = alloc(32);
    store64(a, ct);
    store64(a + 8, quality);
    store64(a + 16, complexity);
    store64(a + 24, vec_new());
    return a;
}

fn analysis_content_type(a)  { return load64(a); }
fn analysis_quality(a)       { return load64(a + 8); }
fn analysis_complexity(a)    { return load64(a + 16); }
fn analysis_tags(a)          { return load64(a + 24); }

# Classify media content based on MediaInfo metadata.
# Returns MediaAnalysis.
fn analyze_media(mi) {
    var has_video = media_info_has_video(mi);
    var has_audio = media_info_has_audio(mi);
    var ct = CT_UNKNOWN;
    var quality = f64_from(50);
    var complexity = f64_from(30);
    var tag_vec = vec_new();

    if (has_video == 1) {
        if (has_audio == 1) {
            ct = CT_MOVIE;
            complexity = f64_from(60);
        } else {
            ct = CT_ANIMATION;
        }
        vec_push(tag_vec, str_from("video"));

        var vs = media_info_video_stream(mi, 0);
        if (vs != 0) {
            var w = video_stream_width(vs);
            if (w >= 3840) {
                vec_push(tag_vec, str_from("4k"));
                quality = f64_from(80);
            }
            elif (w >= 1920) {
                vec_push(tag_vec, str_from("hd"));
                quality = f64_from(70);
            }
        }
    }
    elif (has_audio == 1) {
        var as_ptr = media_info_audio_stream(mi, 0);
        if (as_ptr != 0) {
            var codec = audio_stream_codec(as_ptr);
            var ch = audio_stream_channels(as_ptr);
            var sr = audio_stream_sample_rate(as_ptr);

            if (ch >= 2) {
                ct = CT_MUSIC;
                vec_push(tag_vec, str_from("stereo"));
            } else {
                ct = CT_SPEECH;
                vec_push(tag_vec, str_from("mono"));
            }

            if (sr >= 44100) {
                vec_push(tag_vec, str_from("hifi"));
                quality = f64_from(70);
            }

            if (codec == AUDIO_FLAC) {
                vec_push(tag_vec, str_from("lossless"));
                quality = f64_from(90);
            }
            elif (codec == AUDIO_MP3) {
                vec_push(tag_vec, str_from("lossy"));
                quality = f64_from(60);
            }
        }
        vec_push(tag_vec, str_from("audio"));
    }

    var a = media_analysis_new(ct, quality, complexity);
    store64(a + 24, tag_vec);
    return a;
}
