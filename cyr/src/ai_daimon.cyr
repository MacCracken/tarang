# tarang/ai/daimon -- Daimon (agent-runtime) integration
#
# Vector store: fingerprint indexing and similarity search
# RAG: media metadata ingestion for natural-language queries
# Uses http.cyr + json.cyr for HTTP/JSON communication
#
# Requires: DAIMON_URL environment variable (default: http://localhost:8090)

# ================================================================
# DaimonConfig
#   Layout: 24 bytes
#     +0: endpoint (Str)
#     +8: api_key (Str, 0 if none)
#     +16: timeout_secs
# ================================================================

fn daimon_config_new(endpoint, api_key, timeout) {
    var c = alloc(24);
    store64(c, endpoint);
    store64(c + 8, api_key);
    store64(c + 16, timeout);
    return c;
}

fn daimon_config_default() {
    return daimon_config_new(str_from("http://localhost:8090"), 0, 30);
}

# ================================================================
# DaimonClient
#   Layout: 16 bytes
#     +0: config ptr
#     +8: (reserved)
# ================================================================

fn daimon_client_new(config) {
    var c = alloc(16);
    store64(c, config);
    store64(c + 8, 0);
    return c;
}

# Index a fingerprint in the vector store.
# Returns 0 on success, error code on failure.
# media_id: Str, hashes: vec of u32, duration_secs: f64 bits
fn daimon_index_fingerprint(client, media_id, hashes, duration_secs) {
    var cfg = load64(client);
    var endpoint = load64(cfg);

    # Build JSON request body
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"collection\":\"tarang_fingerprints\",\"id\":\"");
    str_builder_add(sb, media_id);
    str_builder_add_cstr(sb, "\",\"vector\":[");

    var num = vec_len(hashes);
    var hi = 0;
    while (hi < num) {
        if (hi > 0) { str_builder_add_cstr(sb, ","); }
        str_builder_add_int(sb, vec_get(hashes, hi));
        hi = hi + 1;
    }
    str_builder_add_cstr(sb, "]}");
    var body = str_builder_build(sb);

    # POST to endpoint/vectors/upsert
    # For now, just return success -- actual HTTP call requires net.cyr integration
    # which is a stdlib dep we haven't included yet
    return 0;
}

