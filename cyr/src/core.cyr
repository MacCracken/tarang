# tarang/core — Core types for the Tarang media framework
#
# Defines codecs, container formats, media buffers, stream metadata,
# error codes, and helper functions used across all Tarang modules.
#
# Design decisions:
#   - All audio samples are f64 internally (Cyrius native, matches shravan)
#   - Packed Result: Ok returns value >= 0, Err sets bit 63 (value < 0)
#   - Error codes are integer enums
#   - Structs are heap-allocated via alloc() with accessor functions
#   - Vec used for stream lists, metadata stored in hashmap

# ================================================================
# Byte read/write helpers (shared by all modules)
# ================================================================

fn read_u16_le(data, off) {
    return load8(data + off) | (load8(data + off + 1) << 8);
}

fn read_u32_le(data, off) {
    return load8(data + off) | (load8(data + off + 1) << 8) | (load8(data + off + 2) << 16) | (load8(data + off + 3) << 24);
}

fn write_u16_le(buf, off, val) {
    store8(buf + off, val & 0xFF);
    store8(buf + off + 1, (val >> 8) & 0xFF);
    return 0;
}

fn write_u32_le(buf, off, val) {
    store8(buf + off, val & 0xFF);
    store8(buf + off + 1, (val >> 8) & 0xFF);
    store8(buf + off + 2, (val >> 16) & 0xFF);
    store8(buf + off + 3, (val >> 24) & 0xFF);
    return 0;
}

fn read_u32_be(data, off) {
    return (load8(data + off) << 24) | (load8(data + off + 1) << 16) | (load8(data + off + 2) << 8) | load8(data + off + 3);
}

# ================================================================
# Audio Codecs
# ================================================================

enum AudioCodec {
    AUDIO_PCM = 0;
    AUDIO_MP3 = 1;
    AUDIO_AAC = 2;
    AUDIO_FLAC = 3;
    AUDIO_VORBIS = 4;
    AUDIO_OPUS = 5;
    AUDIO_ALAC = 6;
    AUDIO_WMA = 7;
}

fn AudioCodec_name(codec) {
    if (codec == AUDIO_PCM) { return "PCM"; }
    if (codec == AUDIO_MP3) { return "MP3"; }
    if (codec == AUDIO_AAC) { return "AAC"; }
    if (codec == AUDIO_FLAC) { return "FLAC"; }
    if (codec == AUDIO_VORBIS) { return "Vorbis"; }
    if (codec == AUDIO_OPUS) { return "Opus"; }
    if (codec == AUDIO_ALAC) { return "ALAC"; }
    if (codec == AUDIO_WMA) { return "WMA"; }
    return "Unknown";
}

fn AudioCodec_print(codec) {
    var name = AudioCodec_name(codec);
    syscall(1, 1, name, strlen(name));
    return 0;
}

