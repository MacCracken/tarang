# tarang/demux/wav — WAV (RIFF WAVE) container demuxer
#
# Pure Cyrius RIFF parser. Scans fmt + data chunks, supports:
#   - PCM format code 1 (8/16/24/32-bit)
#   - Skips unknown chunks (LIST, fact, etc.)
#   - Seek by sample offset
#
# Works on file descriptors (fd) with read/lseek syscalls.

# SYS_LSEEK = 8, SEEK_SET = 0, SEEK_CUR = 1
var SYS_LSEEK = 8;
var SEEK_SET = 0;
var SEEK_CUR = 1;

fn wav_lseek(fd, offset, whence) {
    return syscall(SYS_LSEEK, fd, offset, whence);
}

# ================================================================
# WavDemuxer state
#   Layout: 72 bytes
#     +0:  fd (file descriptor)
#     +8:  data_offset (byte position of data chunk start)
#     +16: data_size (byte length of data chunk)
#     +24: bytes_read (bytes consumed from data chunk)
#     +32: sample_rate
#     +40: channels
#     +48: bits_per_sample
#     +56: media_info (ptr, 0 if not probed)
#     +64: probed (1 if probe() called)
# ================================================================

fn wav_demuxer_new(fd) {
    var d = alloc(72);
    store64(d,      fd);
    store64(d + 8,  0);
    store64(d + 16, 0);
    store64(d + 24, 0);
    store64(d + 32, 0);
    store64(d + 40, 0);
    store64(d + 48, 0);
    store64(d + 56, 0);
    store64(d + 64, 0);
    return d;
}

fn wav_fd(d)             { return load64(d); }
fn wav_data_offset(d)    { return load64(d + 8); }
fn wav_data_size(d)      { return load64(d + 16); }
fn wav_bytes_read(d)     { return load64(d + 24); }
fn wav_sample_rate(d)    { return load64(d + 32); }
fn wav_channels(d)       { return load64(d + 40); }
fn wav_bits_per_sample(d){ return load64(d + 48); }
fn wav_media_info(d)     { return load64(d + 56); }

# Read exactly n bytes from fd into buf. Returns 0 on success, err on failure.
fn wav_read_exact(fd, buf, n) {
    var total = 0;
    while (total < n) {
        var r = syscall(0, fd, buf + total, n - total);
        if (r <= 0) { return tarang_err(ERR_DEMUX); }
        total = total + r;
    }
    return 0;
}

# Byte helpers: read_u16_le, read_u32_le, write_u32_le defined in core.cyr

# ================================================================
# wav_probe — parse RIFF WAVE header, find fmt + data chunks
# ================================================================

fn wav_probe(d) {
    var fd = wav_fd(d);

    # Read 12-byte RIFF header
    var hdr = alloc(12);
    var r = wav_read_exact(fd, hdr, 12);
    if (tarang_is_err(r) == 1) { return tarang_err(ERR_DEMUX); }

    # Validate RIFF....WAVE
    if (memeq(hdr, "RIFF", 4) != 1) { return tarang_err(ERR_UNSUPPORTED_FORMAT); }
    if (memeq(hdr + 8, "WAVE", 4) != 1) { return tarang_err(ERR_UNSUPPORTED_FORMAT); }

    # Scan chunks
    var chunk_hdr = alloc(8);
    var fmt_buf = alloc(16);
    var found_fmt = 0;
    var found_data = 0;

    while (found_data == 0) {
        var cr = wav_read_exact(fd, chunk_hdr, 8);
        if (tarang_is_err(cr) == 1) { break; }

        var chunk_size = read_u32_le(chunk_hdr, 4);

        # fmt chunk
        if (memeq(chunk_hdr, "fmt ", 4) == 1) {
            if (chunk_size < 16) { return tarang_err(ERR_DEMUX); }
            var fr = wav_read_exact(fd, fmt_buf, 16);
            if (tarang_is_err(fr) == 1) { return tarang_err(ERR_DEMUX); }

            store64(d + 40, read_u16_le(fmt_buf, 2));   # channels
            store64(d + 32, read_u32_le(fmt_buf, 4));    # sample_rate
            store64(d + 48, read_u16_le(fmt_buf, 14));   # bits_per_sample
            found_fmt = 1;

            # Skip extra fmt bytes
            if (chunk_size > 16) {
                wav_lseek(fd, chunk_size - 16, SEEK_CUR);
            }
        }
        # data chunk
        elif (memeq(chunk_hdr, "data", 4) == 1) {
            var pos = wav_lseek(fd, 0, SEEK_CUR);
            store64(d + 8, pos);
            store64(d + 16, chunk_size);
            found_data = 1;
        }
        # Unknown chunk — skip
        else {
            wav_lseek(fd, chunk_size, SEEK_CUR);
        }
    }

    var sr = wav_sample_rate(d);
    var ch = wav_channels(d);
    var bps = wav_bits_per_sample(d);

    if (sr == 0) { return tarang_err(ERR_DEMUX); }
    if (ch == 0) { return tarang_err(ERR_DEMUX); }
    if (bps == 0) { return tarang_err(ERR_DEMUX); }

    # Compute duration
    var bytes_per_sample = bps / 8;
    var frame_size = bytes_per_sample * ch;
    var data_size = wav_data_size(d);
    var total_samples = 0;
    if (frame_size > 0) { total_samples = data_size / frame_size; }

    var dur_ns = 0;
    if (sr > 0) {
        # dur_ns = total_samples * 1_000_000_000 / sr
        # Use f64 to avoid overflow
        var f_samples = f64_from(total_samples);
        var f_sr = f64_from(sr);
        var f_billion = f64_from(1000000000);
        dur_ns = f64_to(f64_div(f64_mul(f_samples, f_billion), f_sr));
    }

    # Sample format
    var sfmt = SAMPLE_I16;
    if (bps == 32) { sfmt = SAMPLE_I32; }

    # Bitrate
    var bitrate = sr * ch * bps;

    # Build MediaInfo
    var as_info = audio_stream_new(AUDIO_PCM, sr, ch, sfmt, bitrate, dur_ns);
    var streams = vec_new();
    vec_push(streams, stream_audio(as_info));
    var mi = media_info_new(FMT_WAV, streams);
    media_info_set_duration_ns(mi, dur_ns);

    store64(d + 56, mi);
    store64(d + 64, 1);
    store64(d + 24, 0);

    return mi;
}

# ================================================================
# wav_next_packet — read next chunk of PCM data
# ================================================================

fn wav_next_packet(d) {
    var bytes_read = wav_bytes_read(d);
    var data_size = wav_data_size(d);

    if (bytes_read >= data_size) { return tarang_err(ERR_END_OF_STREAM); }

    var remaining = data_size - bytes_read;
    var chunk_size = 4096;
    if (remaining < chunk_size) { chunk_size = remaining; }
    if (chunk_size == 0) { return tarang_err(ERR_END_OF_STREAM); }

    var buf = alloc(chunk_size);
    var fd = wav_fd(d);
    var n = syscall(0, fd, buf, chunk_size);
    if (n <= 0) { return tarang_err(ERR_END_OF_STREAM); }

    # Compute timestamp from bytes_read
    var bps = wav_bits_per_sample(d);
    var ch = wav_channels(d);
    var sr = wav_sample_rate(d);
    var frame_size = (bps / 8) * ch;
    var ts_ns = 0;
    if (frame_size > 0) {
        if (sr > 0) {
            var samples = bytes_read / frame_size;
            var f_samples = f64_from(samples);
            var f_sr = f64_from(sr);
            var f_billion = f64_from(1000000000);
            ts_ns = f64_to(f64_div(f64_mul(f_samples, f_billion), f_sr));
        }
    }

    store64(d + 24, bytes_read + n);

    return packet_new(0, buf, n, ts_ns, 1);
}

# ================================================================
# wav_seek — seek to a timestamp (nanoseconds)
# ================================================================

fn wav_seek(d, ts_ns) {
    var bps = wav_bits_per_sample(d);
    var ch = wav_channels(d);
    var sr = wav_sample_rate(d);
    var frame_size = (bps / 8) * ch;
    if (frame_size == 0) { return tarang_err(ERR_DEMUX); }

    # target_sample = ts_ns * sr / 1_000_000_000
    var f_ts = f64_from(ts_ns);
    var f_sr = f64_from(sr);
    var f_billion = f64_from(1000000000);
    var target_sample = f64_to(f64_div(f64_mul(f_ts, f_sr), f_billion));

    var byte_offset = target_sample * frame_size;
    var data_size = wav_data_size(d);
    if (byte_offset > data_size) { byte_offset = data_size; }

    var data_offset = wav_data_offset(d);
    wav_lseek(wav_fd(d), data_offset + byte_offset, SEEK_SET);
    store64(d + 24, byte_offset);
    return 0;
}

# ================================================================
# wav_demuxer_from_buffer — create demuxer from in-memory buffer
#   For testing: writes buffer to a temp file, opens fd.
#   In production, demuxers work on real file fds.
# ================================================================

fn wav_demuxer_from_buf(data, len) {
    var path = "/tmp/tarang_wav_test.wav";
    var fd = syscall(2, path, 577, 0x1A4);  # O_WRONLY|O_CREAT|O_TRUNC, 0644
    if (fd < 0) { return 0; }
    syscall(1, fd, data, len);
    syscall(3, fd);

    var rfd = syscall(2, path, 0, 0);  # O_RDONLY
    if (rfd < 0) { return 0; }
    return wav_demuxer_new(rfd);
}

# ================================================================
# make_wav — build a WAV file in memory for testing
#   Returns pointer to buffer. Sets *out_len to total size.
# ================================================================

fn make_wav(num_samples, sample_rate, channels, bits) {
    var bytes_per_sample = bits / 8;
    var data_size = num_samples * channels * bytes_per_sample;
    var file_size = 36 + data_size;
    var byte_rate = sample_rate * channels * bytes_per_sample;
    var block_align = channels * bytes_per_sample;

    var total = 44 + data_size;
    var buf = alloc(total);
    memset(buf, 0, total);

    # RIFF header
    memcpy(buf, "RIFF", 4);
    store8(buf + 4, file_size & 0xFF);
    store8(buf + 5, (file_size >> 8) & 0xFF);
    store8(buf + 6, (file_size >> 16) & 0xFF);
    store8(buf + 7, (file_size >> 24) & 0xFF);
    memcpy(buf + 8, "WAVE", 4);

    # fmt chunk
    memcpy(buf + 12, "fmt ", 4);
    store8(buf + 16, 16);  # chunk size = 16
    store8(buf + 17, 0);
    store8(buf + 18, 0);
    store8(buf + 19, 0);
    store8(buf + 20, 1);  # format = PCM
    store8(buf + 21, 0);
    store8(buf + 22, channels & 0xFF);
    store8(buf + 23, (channels >> 8) & 0xFF);
    store8(buf + 24, sample_rate & 0xFF);
    store8(buf + 25, (sample_rate >> 8) & 0xFF);
    store8(buf + 26, (sample_rate >> 16) & 0xFF);
    store8(buf + 27, (sample_rate >> 24) & 0xFF);
    store8(buf + 28, byte_rate & 0xFF);
    store8(buf + 29, (byte_rate >> 8) & 0xFF);
    store8(buf + 30, (byte_rate >> 16) & 0xFF);
    store8(buf + 31, (byte_rate >> 24) & 0xFF);
    store8(buf + 32, block_align & 0xFF);
    store8(buf + 33, (block_align >> 8) & 0xFF);
    store8(buf + 34, bits & 0xFF);
    store8(buf + 35, (bits >> 8) & 0xFF);

    # data chunk
    memcpy(buf + 36, "data", 4);
    store8(buf + 40, data_size & 0xFF);
    store8(buf + 41, (data_size >> 8) & 0xFF);
    store8(buf + 42, (data_size >> 16) & 0xFF);
    store8(buf + 43, (data_size >> 24) & 0xFF);
    # PCM data is all zeros (silence)

    # Store total size at a known location so caller can retrieve it
    # We return a 2-value: buf in rax, total via ret2
    ret2(buf, total);
    return buf;
}
