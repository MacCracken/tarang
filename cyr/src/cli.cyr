# tarang/cli -- Command-line interface
#
# Subcommands:
#   tarang probe <path>     -- probe media file, print info
#   tarang codecs           -- list supported codecs
#   tarang version          -- print version
#   tarang help             -- show usage

var TARANG_VERSION = "2.0.0";

fn cli_print_usage() {
    syscall(1, 1, "tarang -- AI-native media framework\n", 36);
    syscall(1, 1, "\n", 1);
    syscall(1, 1, "Usage:\n", 7);
    syscall(1, 1, "  tarang probe <path>  Probe media file\n", 40);
    syscall(1, 1, "  tarang codecs        List supported codecs\n", 46);
    syscall(1, 1, "  tarang version       Print version\n", 36);
    syscall(1, 1, "  tarang help          Show this help\n", 37);
    return 0;
}

fn cli_print_version() {
    syscall(1, 1, "tarang ", 7);
    syscall(1, 1, TARANG_VERSION, strlen(TARANG_VERSION));
    syscall(1, 1, " (Cyrius)\n", 10);
    return 0;
}

fn cli_cmd_codecs() {
    syscall(1, 1, "Audio codecs (shravan):\n", 23);
    syscall(1, 1, "  PCM MP3 FLAC Vorbis Opus AAC ALAC\n", 36);
    syscall(1, 1, "Containers:\n", 12);
    syscall(1, 1, "  WAV OGG MP4 MKV WebM FLAC MP3 AVI\n", 36);
    return 0;
}

fn cli_probe_print_stream(stream_entry, idx) {
    syscall(1, 1, "  [", 3);
    fmt_int(idx);
    syscall(1, 1, "] ", 2);

    if (stream_is_audio(stream_entry) == 1) {
        var ainfo = stream_ptr(stream_entry);
        syscall(1, 1, "Audio: ", 7);
        var aname = AudioCodec_name(audio_stream_codec(ainfo));
        syscall(1, 1, aname, strlen(aname));
        syscall(1, 1, " ", 1);
        fmt_int(audio_stream_sample_rate(ainfo));
        syscall(1, 1, "Hz ", 3);
        fmt_int(audio_stream_channels(ainfo));
        syscall(1, 1, "ch", 2);
    }
    elif (stream_is_video(stream_entry) == 1) {
        var vinfo = stream_ptr(stream_entry);
        syscall(1, 1, "Video: ", 7);
        var vname = VideoCodec_name(video_stream_codec(vinfo));
        syscall(1, 1, vname, strlen(vname));
        syscall(1, 1, " ", 1);
        fmt_int(video_stream_width(vinfo));
        syscall(1, 1, "x", 1);
        fmt_int(video_stream_height(vinfo));
    }
    else {
        syscall(1, 1, "Subtitle", 8);
    }
    syscall(1, 1, "\n", 1);
    return 0;
}

fn cli_cmd_probe(probe_path) {
    var probe_fd = syscall(2, probe_path, 0, 0);
    if (probe_fd < 0) {
        syscall(1, 2, "error: cannot open file\n", 24);
        return 1;
    }

    var probe_magic = alloc(16);
    var probe_nr = syscall(0, probe_fd, probe_magic, 16);
    if (probe_nr < 12) {
        syscall(1, 2, "error: file too small\n", 22);
        syscall(3, probe_fd);
        return 1;
    }

    var probe_fmt = container_from_magic(probe_magic, probe_nr);
    wav_lseek(probe_fd, 0, SEEK_SET);

    var probe_mi = 0;

    if (probe_fmt == FMT_WAV) {
        probe_mi = wav_probe(wav_demuxer_new(probe_fd));
    }
    elif (probe_fmt == FMT_OGG) {
        probe_mi = ogg_demux_probe(ogg_demuxer_new(probe_fd));
    }
    elif (probe_fmt == FMT_MP4) {
        probe_mi = mp4_demux_probe(mp4_demuxer_new(probe_fd));
    }
    elif (probe_fmt == FMT_MKV) {
        probe_mi = mkv_demux_probe(mkv_demuxer_new(probe_fd));
    }
    elif (probe_fmt == FMT_WEBM) {
        probe_mi = mkv_demux_probe(mkv_demuxer_new(probe_fd));
    }
    else {
        syscall(1, 2, "error: unsupported format\n", 26);
        syscall(3, probe_fd);
        return 1;
    }

    if (tarang_is_err(probe_mi) == 1) {
        syscall(1, 2, "error: probe failed\n", 20);
        syscall(3, probe_fd);
        return 1;
    }

    # Format
    syscall(1, 1, "Format:   ", 10);
    var probe_fmt_name = ContainerFormat_name(media_info_format(probe_mi));
    syscall(1, 1, probe_fmt_name, strlen(probe_fmt_name));
    syscall(1, 1, "\n", 1);

    # Duration
    var probe_dur = media_info_duration_ns(probe_mi);
    if (probe_dur > 0) {
        syscall(1, 1, "Duration: ", 10);
        var probe_ms = probe_dur / 1000000;
        var probe_s = probe_ms / 1000;
        var probe_frac = probe_ms % 1000;
        fmt_int(probe_s);
        syscall(1, 1, ".", 1);
        if (probe_frac < 100) { syscall(1, 1, "0", 1); }
        if (probe_frac < 10) { syscall(1, 1, "0", 1); }
        fmt_int(probe_frac);
        syscall(1, 1, "s\n", 2);
    }

    # Streams
    var probe_streams = media_info_streams(probe_mi);
    var probe_count = vec_len(probe_streams);
    syscall(1, 1, "Streams:  ", 10);
    fmt_int(probe_count);
    syscall(1, 1, "\n", 1);

    var probe_i = 0;
    while (probe_i < probe_count) {
        cli_probe_print_stream(vec_get(probe_streams, probe_i), probe_i);
        probe_i = probe_i + 1;
    }

    syscall(3, probe_fd);
    return 0;
}

fn cli_main() {
    args_init();
    var cli_ac = argc();

    if (cli_ac < 2) {
        cli_print_usage();
        return 0;
    }

    var cli_cmd = argv(1);

    if (streq(cli_cmd, "probe") == 1) {
        if (cli_ac < 3) {
            syscall(1, 2, "error: probe requires a file path\n", 35);
            return 1;
        }
        return cli_cmd_probe(argv(2));
    }
    elif (streq(cli_cmd, "codecs") == 1) {
        return cli_cmd_codecs();
    }
    elif (streq(cli_cmd, "version") == 1) {
        cli_print_version();
        return 0;
    }
    elif (streq(cli_cmd, "help") == 1) {
        cli_print_usage();
        return 0;
    }
    else {
        syscall(1, 2, "error: unknown command\n", 23);
        cli_print_usage();
        return 1;
    }
    return 0;
}
